0002-9297 (Linking)},
   DOI = {10.1016/j.ajhg.2023.08.015},
   url = {https://www.ncbi.nlm.nih.gov/pubmed/37725976},
   year = {2023},
   type = {Journal Article}
}

@article{RN8,
   author = {Medina-Rivas, M. A. and Norris, E. T. and Rishishwar, L. and Conley, A. B. and Medrano-Trochez, C. and Valderrama-Aguirre, A. and Vannberg, F. O. and Marino-Ramirez, L. and Jordan, I. K.},
