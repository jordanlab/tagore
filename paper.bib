@article{RN7,
   author = {Conley, A. B. and Rishishwar, L. and Norris, E. T. and Valderrama-Aguirre, A. and Marino-Ramirez, L. and Medina-Rivas, M. A. and Jordan, I. K.},
   title = {A Comparative Analysis of Genetic Ancestry and Admixture in the Colombian Populations of Choco and Medellin},
