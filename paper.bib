@article{RN17,
   author = {Medina-Munoz, S. G. and Ortega-Del Vecchyo, D. and Cruz-Hervert, L. P. and Ferreyra-Reyes, L. and Garcia-Garcia, L. and Moreno-Estrada, A. and Ragsdale, A. P.},
   title = {Demographic modeling of admixed Latin American populations from whole genomes},
   journal = {Am J Hum Genet},
   volume = {110},
